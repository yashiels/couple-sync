# Postgres connection string. Local dev: the docker-compose `postgres` service.
# On the VPS the compose file overrides this to postgres://couple:couple@postgres:5432/couplesync
DATABASE_URL=postgres://couple:couple@localhost:5432/couplesync

# Firebase Spark project ID (Project Settings → General).
FIREBASE_PROJECT_ID=

# Stringified JSON of the Firebase service-account key
# (Project Settings → Service Accounts → generate new private key → paste the
# entire JSON contents here as a single line, escaped). The backend parses it
# via firebase-admin.initializeApp({ credential: applicationDefault() }).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Domain Caddy will serve on (used in the Caddyfile + Flutter baseUrl).
DOMAIN=api.example.com

# Port the api container listens on (Caddy reverse-proxies to this).
PORT=3000

# Optional shared secret guarding POST /admin/* endpoints (manual cron
# triggers). When unset/empty, admin routes respond 503. Not Firebase auth.
ADMIN_TOKEN=
