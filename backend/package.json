{
  "name": "couple-sync-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && cp -R src/migrations dist/migrations",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "fastify": "^5.12.5",
    "firebase-admin": "^13.1.0",
    "luxon": "^3.7.2",
    "pg": "^8.13.1",
    "rrule": "^2.8.1",
    "ws": "^8.18.0"
  },
  "pnpm": {
    "overrides": {
      "@fastify/busboy@<3.2.1": "^3.2.1",
      "@grpc/grpc-js@<1.14.5": "^1.14.5"
    }
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
