# Copy to .env (gitignored) and fill in. Both are read by app.config.ts into expo `extra`.
#
# With 1Password access, skip the manual copy — `bash scripts/pull-secrets.sh` fills in .env,
# backend/.env, google-services.json, and the Android signing keystore in one shot. Then build with
# JDK 17 (AGP fails on newer JDKs):  JAVA_HOME=$(/usr/libexec/java_home -v 17) npm run android

# Base URL of the Fastify backend, no trailing slash. An Android emulator reaches the host machine at
# 10.0.2.2, never localhost.
API_BASE_URL=http://10.0.2.2:3000

# The **Web** OAuth client id from the Firebase console (Project settings -> your apps -> Web client),
# not the Android one. @react-native-google-signin needs the Web id as `webClientId`; with the Android
# id, or unset, sign-in never resolves.
GOOGLE_WEB_CLIENT_ID=
